# This optional module never adds the bridge to the game runtime
function(iw_add_steam_identity_fixture)
    if(NOT WIN32 OR NOT MINGW OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "The identity fixture requires a Windows x64 MinGW caller")
    endif()
    set(IW_STEAM_SDK121_INCLUDE_DIR "" CACHE PATH "External licensed SDK121 include directory")
    set(IW_IDENTITY_MS_CLANG "clang++" CACHE FILEPATH "Clang compiler supporting the Microsoft x64 target")
    if(NOT IW_STEAM_SDK121_INCLUDE_DIR)
        message(FATAL_ERROR "Supply an external SDK121 include directory; SDK headers are not bundled")
    endif()
    if(NOT EXISTS "${IW_STEAM_SDK121_INCLUDE_DIR}/isteamuser.h")
        message(FATAL_ERROR "SDK121 is missing isteamuser.h")
    endif()
    file(SHA256 "${IW_STEAM_SDK121_INCLUDE_DIR}/isteamuser.h" header_hash)
    if(NOT header_hash STREQUAL "c2436d3a698d86ffc3b9b62711801cd779e2d04c5cc8120230a240a9c504d54d")
        message(FATAL_ERROR "SDK121 declaration fingerprint differs: isteamuser.h")
    endif()
    if(NOT EXISTS "${IW_STEAM_SDK121_INCLUDE_DIR}/steamclientpublic.h")
        message(FATAL_ERROR "SDK121 is missing steamclientpublic.h")
    endif()
    file(SHA256 "${IW_STEAM_SDK121_INCLUDE_DIR}/steamclientpublic.h" header_hash)
    if(NOT header_hash STREQUAL "a04e7396293bb4f3bec3ccf3b0fad204f8e664e5b9ca51141cb2d99e3a02b63f")
        message(FATAL_ERROR "SDK121 declaration fingerprint differs: steamclientpublic.h")
    endif()
    if(NOT EXISTS "${IW_STEAM_SDK121_INCLUDE_DIR}/isteamclient.h")
        message(FATAL_ERROR "SDK121 is missing isteamclient.h")
    endif()
    file(SHA256 "${IW_STEAM_SDK121_INCLUDE_DIR}/isteamclient.h" header_hash)
    if(NOT header_hash STREQUAL "2dd5cbbf4d4f023cafbbb301e5e485c533a5a110508e248e5b794545ddcbac01")
        message(FATAL_ERROR "SDK121 declaration fingerprint differs: isteamclient.h")
    endif()
    if(NOT EXISTS "${IW_STEAM_SDK121_INCLUDE_DIR}/steamtypes.h")
        message(FATAL_ERROR "SDK121 is missing steamtypes.h")
    endif()
    file(SHA256 "${IW_STEAM_SDK121_INCLUDE_DIR}/steamtypes.h" header_hash)
    if(NOT header_hash STREQUAL "48564aaa07a5e6fb6545bb0748b55f2b9acdbd842fa10a80079506d879eaff9f")
        message(FATAL_ERROR "SDK121 declaration fingerprint differs: steamtypes.h")
    endif()
    get_filename_component(identity_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    set(ms_flags --target=x86_64-pc-windows-msvc -std=c++20 -O2 -Wall -Wextra -Werror -fno-exceptions -fno-rtti)
    set(sdk_headers)
    foreach(header IN ITEMS isteamuser.h steamclientpublic.h isteamclient.h steamtypes.h)
        list(APPEND sdk_headers "${IW_STEAM_SDK121_INCLUDE_DIR}/${header}")
    endforeach()
    foreach(unit IN ITEMS SteamUser016Bridge FixtureSteamUser)
        if(unit STREQUAL "SteamUser016Bridge")
            set(source "${identity_root}/native/identity/${unit}.cpp")
            set(private_header "${identity_root}/native/identity/SteamUser016Bridge.h")
        else()
            set(source "${identity_root}/tests/native-identity/${unit}.cpp")
            set(private_header "${identity_root}/tests/native-identity/FixtureSteamUser.h")
        endif()
        set(object "${CMAKE_CURRENT_BINARY_DIR}/${unit}.obj")
        set(assembly "${CMAKE_CURRENT_BINARY_DIR}/${unit}.s")
        # Separate compiler invocations prevent a shared C++ ABI from hiding the boundary
        add_custom_command(OUTPUT "${object}" "${assembly}"
            COMMAND "${IW_IDENTITY_MS_CLANG}" ${ms_flags} -I "${IW_STEAM_SDK121_INCLUDE_DIR}" -c "${source}" -o "${object}"
            COMMAND "${IW_IDENTITY_MS_CLANG}" ${ms_flags} -I "${IW_STEAM_SDK121_INCLUDE_DIR}" -S "${source}" -o "${assembly}"
            DEPENDS "${source}" "${private_header}" ${sdk_headers} VERBATIM)
        set_source_files_properties("${object}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
        list(APPEND objects "${object}")
    endforeach()
    add_executable(iw_steam_identity_fixture
        "${identity_root}/tests/native-identity/SteamUser016BridgeTests.cpp" ${objects})
    target_compile_features(iw_steam_identity_fixture PRIVATE cxx_std_20)
    target_compile_options(iw_steam_identity_fixture PRIVATE -Wall -Wextra -Werror)
    # Static compiler runtimes keep the isolated fixture independent of extra MinGW DLLs
    target_link_options(iw_steam_identity_fixture PRIVATE -static)
    set_target_properties(iw_steam_identity_fixture PROPERTIES CXX_EXTENSIONS OFF)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_test(NAME SteamIdentityStaticAbi COMMAND "${Python3_EXECUTABLE}"
        "${identity_root}/tests/native-identity/test_assembly_contract.py" "${CMAKE_CURRENT_BINARY_DIR}")
    # The Windows executable is run only by an authorized offline fixture runner
    add_test(NAME SteamIdentityPlainBoundary COMMAND iw_steam_identity_fixture)
endfunction()
